# Puedes usar DATABASE_URL o las variables PG* por separado.
DATABASE_URL=postgresql://usuario:contraseña@servidor:5432/postgres
PGHOST=aws-0-eu-west-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=usuario
PGPASSWORD=contraseña
DATABASE_SSL=true
PUBLIC_APP_URL=http://localhost:3000
# Recuperación de contraseña mediante Resend
RESEND_API_KEY=
EMAIL_FROM=OrganizaT <no-reply@tu-dominio.com>
HOST=127.0.0.1
PORT=3000
